{
  "name": "aigrounds",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "preinstall": "node -e \"const ua = process.env.npm_config_user_agent || ''; if (!ua.startsWith('pnpm/')) { console.error('Use pnpm for this repo.'); process.exit(1); }\"",
    "dev": "python3 scripts/infisical/run.py dev",
    "build": "node scripts/check-curriculum.mjs && node scripts/verify-lesson-tests.mjs && node scripts/prepare-ocr-assets.mjs && node scripts/update-playground-dates.mjs && node scripts/verify-provider-routing.mjs && next build",
    "check:cycles": "node scripts/check-import-cycles.mjs",
    "check:curriculum": "node scripts/check-curriculum.mjs",
    "start": "node scripts/dev-server.mjs next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --pretty false",
    "test:deps": "node scripts/dependency-smoke.mjs",
    "check:bridges": "node scripts/verify-bridge-engines.mjs",
    "check:tests": "node scripts/verify-lesson-tests.mjs",
    "dev:app": "node scripts/prepare-ocr-assets.mjs && node scripts/update-playground-dates.mjs && node scripts/dev-server.mjs next dev",
    "dev:secrets": "python3 scripts/infisical/run.py dev",
    "build:secrets": "python3 scripts/infisical/run.py build",
    "start:secrets": "python3 scripts/infisical/run.py start",
    "secrets:check": "python3 scripts/infisical/run.py check",
    "test:secrets": "python3 -m unittest discover -s scripts/infisical -p test_secrets.py",
    "test:provider": "node scripts/verify-provider-routing.mjs",
    "prepare:ocr": "node scripts/prepare-ocr-assets.mjs"
  },
  "dependencies": {
    "@heroicons/react": "2.2.0",
    "@sentry/nextjs": "^10.75.2",
    "@vercel/analytics": "^1.6.1",
    "@xyflow/react": "12.12.0",
    "next": "16.4.2",
    "onnxruntime-web": "1.30.0",
    "pdfjs-dist": "5.4.296",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
