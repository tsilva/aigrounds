{
  "name": "aigrounds",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "preinstall": "node -e \"const ua = process.env.npm_config_user_agent || ''; if (!ua.startsWith('pnpm/')) { console.error('Use pnpm for this repo.'); process.exit(1); }\"",
    "dev": "node scripts/dev-server.mjs next dev",
    "build": "next build",
    "check:cycles": "node scripts/check-import-cycles.mjs",
    "start": "node scripts/dev-server.mjs next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --pretty false",
    "test:deps": "node scripts/dependency-smoke.mjs"
  },
  "dependencies": {
    "@heroicons/react": "2.2.0",
    "@sentry/nextjs": "^10.69.0",
    "@vercel/analytics": "^1.6.1",
    "@xyflow/react": "12.11.2",
    "next": "16.3.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
